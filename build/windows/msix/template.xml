<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="dockiva"
        Arguments=""
        InstallLocation="C:\Program Files\Tomnerb\Dockiva">
    </Installer>
    <PackageInformation
        PackageName="Dockiva"
        PackageDisplayName="Dockiva"
        PublisherName="CN=Tomnerb"
        PublisherDisplayName="Tomnerb"
        Version="0.5.0.0"
        PackageDescription="A native container workspace">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.tomnerb.dockiva"
                Description="A native container workspace"
                DisplayName="Dockiva"
                ExecutableName="dockiva"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Dockiva</DisplayName>
            <PublisherDisplayName>Tomnerb</PublisherDisplayName>
            <Description>A native container workspace</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="dockiva.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
